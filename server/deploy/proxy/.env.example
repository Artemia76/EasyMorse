# Domain name served by the proxy (HTTPS certificate managed by the proxy)
EASYMORSE_DOMAIN=easymorse.example.org
# Public IPv4 address of the server, announced for relayed sessions
EASYMORSE_PUBLIC_IP=203.0.113.10
# Local HTTP port the proxy forwards to (free TCP port, 127.0.0.1 only)
EASYMORSE_PORT=18180
# UDP ports to open in the firewall: STUN/TURN and relayed sessions
EASYMORSE_TURN_PORT=3478
EASYMORSE_RELAY_PORTS=49160-49200
# Permanent rooms, comma separated
EASYMORSE_ROOMS=Beginners,QSO
# Database: a Docker volume name, or a host directory owned by the image's
# easymorse user (docker run --rm --entrypoint id easymorse-server -u). Back it up.
EASYMORSE_DATA=easymorse-data
# Image tag loaded with docker load
EASYMORSE_TAG=latest
